# 内核源码树（8G，不进仓库；裁剪靠 tools/ 脚本复现）
# 注意：必须是 /src/ 带前导斜杠，否则会连 trace/src/ 这类自有源码一起忽略
/src/

# 构建产物：二进制与日志可重建
build/artifacts/
build/initrd/init
build/initrd/root/
*.log
*.o
*.ko
*.so
# kbuild 的依赖缓存，内含绝对路径，每次编译都重新生成
.*.cmd
..module-common.o.cmd

# Python
__pycache__/
*.pyc

# 编辑器/系统
*.swp
.DS_Store

# adapt.py 的机器相关产物（每台机器自己生成，不入库）
notes/.cache/
notes/hw.json
notes/adapt-plan.json
notes/adapt-*.config

# KBUILD_OUTPUT 生成的壳 Makefile，含绝对路径
build/out/
# 19M 二进制，从 artifacts 取即可
build/bzImage-*

# lite 会话记忆（本地状态，不入库）
/mem.bin
/mem.idx
/mem.lock

# plan.py 生成物（按 rules.txt 算出的禁用符号清单，随 config 变）
x96max/trim-tools/disable.list

# 调试截图（遥控按键抓图，本地临时产物）
.rc-photo*.jpg
# 桌面部署现场截图（app.capture 抓回来看效果的，随时重抓）
/logs/desk-*.png

# VDECDBG 抓现场样本（几十万行，用 meson-vdec/tools/vdecdbg-analyze.sh 重出图表）
meson-vdec/logs/

# mupdf 交叉编译现场（源码 + 391M 构建产物，make 可重建）
/mupdf-build/
# readerd 端到端测试现场（build/rtlibs/样本/截图，219M）
/reader-test/
# bench.sh 里写着 NAS 账号密码，只在本机用，绝不入库
/bench.sh
# 遥控器实物照片（本地参考）
/remote.jpg

# 本地临时脚本（rk.sh 之类的一次性调试，不入库）
.scratch/

# EDID 池的调试草稿（edid-pool/ 才是正式产物）
/tmp/
# 视觉回归的比对产物（actual/diff 随用例跑出来）
/logs/check-*.png
