# 内核源码树（12G，不进仓库；裁剪靠 tools/ 脚本复现）
src/

# 构建产物：二进制与日志可重建
build/artifacts/
build/initrd/init
build/initrd/root/
*.log
*.o
*.ko
*.so

# 编辑器/系统
*.swp
.DS_Store

# adapt.py 的机器相关产物（每台机器自己生成，不入库）
notes/.cache/
notes/hw.json
notes/adapt-plan.json
notes/adapt-*.config

# KBUILD_OUTPUT 生成的壳 Makefile，含绝对路径
build/out/
# 19M 二进制，从 artifacts 取即可
build/bzImage-*
