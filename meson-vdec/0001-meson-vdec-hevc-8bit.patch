+		 v4l2_m2m_num_dst_bufs_ready(sess->m2m_ctx),
+		 codec_ops->num_pending_bufs ? codec_ops->num_pending_bufs(sess) : 0,
+		 atomic_read(&sess->esparser_queued_bufs));
