# sandy-dbg-20261111.fragment
# 目标机：小机箱 i5-2400（Sandy Bridge, P67/Q65, i915 核显, RTL8111, ALC662, NVMe, EHCI）
# 基线：config-7.2.12-20261111-hwreal（本机 AMD Ryzen + NVIDIA，已跑通的裁剪版）
#
# 差异只有三类：
#   ① 指令集/GPU 换成目标机的（本机 -march=native=znver2，拿到 Sandy Bridge 上必炸）
#   ② adapt.py 在目标机上探测到「在用但基线没开」的符号，补成 =m
#   ③ 调试设施见 trace-capture.fragment（另附）

# --- ① 版本身份 + 指令集：必须退到 generic x86-64 ---
CONFIG_LOCALVERSION="-sandy-dbg-20261111"
CONFIG_X86_NATIVE_CPU=n

# --- ② GPU：只留 Sandy Bridge 核显，去掉本机的 NVIDIA/AMD 开源路径 ---
CONFIG_DRM_I915=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_AMDGPU=n
CONFIG_DRM_NOUVEAU=n
CONFIG_DRM_VIRTIO_GPU=n
CONFIG_DRM_QXL=n
CONFIG_DRM_VMWGFX=n

# --- ③ 目标机在跑的驱动/子系统（adapt.py plan 报的 absent_config）---
CONFIG_ASYNC_CORE=m
CONFIG_ASYNC_MEMCPY=m
CONFIG_ASYNC_PQ=m
CONFIG_ASYNC_RAID6_RECOV=m
CONFIG_ASYNC_XOR=m
CONFIG_XOR_BLOCKS=m
CONFIG_RAID6_PQ=m
CONFIG_BTRFS_FS=m
CONFIG_MD_RAID0=m
CONFIG_MD_RAID1=m
CONFIG_MD_RAID10=m
CONFIG_MD_RAID456=m
CONFIG_KVM=m
CONFIG_KVM_INTEL=m
CONFIG_LPC_ICH=m
CONFIG_I2C_I801=m
CONFIG_SENSORS_CORETEMP=m
CONFIG_X86_PKG_TEMP_THERMAL=m
CONFIG_INTEL_POWERCLAMP=m
CONFIG_INTEL_RAPL=m
CONFIG_INTEL_RAPL_CORE=m
CONFIG_PERF_EVENTS_INTEL_RAPL=m
CONFIG_EEPROM_AT24=m
CONFIG_MAC_EMUMOUSEBTN=m
CONFIG_NET_SCH_FQ_CODEL=m
CONFIG_SND_HRTIMER=m
CONFIG_SND_SEQ_DUMMY=m
CONFIG_SND_UMP=m

# 主动跳过：CONFIG_CFG80211（这台机器没有无线网卡，基线远端那份是 autoload 带进来的）

# --- ④ netfilter：基线有、这份丢了，补回来（nft/iptables 要能跑）---
# 根因：sandy 的 .config 不是从 hwreal 派生的，是 from-zero 流派生，
#       configs/trim-conservative.fragment 第 7 行把 netfilter 整族关了。
# 注意：nf_tables 的 nft_payload.o 引用 skb_crc32c（net/core/skbuff.c，内置），
#       所以 NF_TABLES 必须和 vmlinux 一起编，不能事后只插 .ko。
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_TABLES_ARP=y
CONFIG_NFT_CT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_REJECT_INET=m
CONFIG_NFT_COMPAT=m
CONFIG_NFT_HASH=m
CONFIG_NFT_FIB=m
CONFIG_NFT_FIB_INET=m
CONFIG_NFT_QUEUE=m
CONFIG_NFT_COUNTER=m
CONFIG_NFT_QUOTA=m
CONFIG_NFT_SOCKET=m
CONFIG_NFT_TPROXY=m
CONFIG_NFT_SYNPROXY=m
CONFIG_NFT_OSF=m
CONFIG_NFT_XFRM=m
CONFIG_NETFILTER_CONNCOUNT=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_MANGLE=m
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_MANGLE=m
CONFIG_IP6_NF_TARGET_REJECT=m
CONFIG_NETFILTER_XTABLES_LEGACY=y
