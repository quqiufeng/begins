[Unit]
Description=desktop (SDL2 KMSDRM file browser, LuaJIT)
After=network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
WorkingDirectory=/opt/desktop
Environment=DESKTOP_HOME=/root
Environment=DESKTOP_FONT_DIR=/opt/reader/assets/fonts
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=HOME=/root
# 直出 app（cage/Wayland）要的运行时环境。cage 缺 XDG_RUNTIME_DIR 会立刻
# 以 "XDG_RUNTIME_DIR is not set" 退出（exit 1），seatd 后端才认 libseat。
Environment=XDG_RUNTIME_DIR=/run/user/0
Environment=LIBSEAT_BACKEND=seatd
StandardInput=null
StandardOutput=journal
StandardError=journal
ExecStartPre=-/bin/rm -f /tmp/desktop-automation.sock
ExecStart=/opt/desktop/run.sh
Restart=always
RestartSec=3
KillMode=process
TTYReset=no

[Install]
WantedBy=multi-user.target
